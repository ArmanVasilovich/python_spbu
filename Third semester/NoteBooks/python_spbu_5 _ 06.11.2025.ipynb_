":{"displayName":"Arman Vasilovich","userId":"14713620520292576430"}}},"execution_count":215,"outputs":[]},{"cell_type":"code","source":["x_train, x_test = x_train / 255.0, x_test / 255.0"],"metadata":{"id":"ajunitisPyPu","executionInfo":{"status":"ok","timestamp":1762434273366,"user_tz":-180,"elapsed":259,"user":{"displayName":"Arman Vasilovich","userId":"14713620520292576430"}}},"execution_count":216,"outputs":[]},{"cell_type":"code","source":["show_mnist(x_train, y_train)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":587},"id":"Jtcg7UaMQjcM","executionInfo":{"status":"ok","timestamp":1762434274566,"user_tz":-180,"elapsed":1122,"user":{"displayName":"Arman Vasilovich","userId":"14713620520292576430"}},"outputId":"113ee925-d072-44f8-a0f3-0d83ac26b46e"},"execution_count":217,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 1000x1000 with 16 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"code","source":["x_train = x_train.reshape((-1, 28*28))\n","x_test = x_test.reshape((-1, 28*28))"],"metadata":{"id":"b5kevS0eQr9R","executionInfo":{"status":"ok","timestamp":1762434408601,"user_tz":-180,"elapsed":900,"user":{"displayName":"Arman Vasilovich","userId":"14713620520292576430"}}},"execution_count":218,"outputs":[]},{"cell_type":"code","source":["x_train.shape"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"C9xOkXBuTGjV","executionInfo":{"status":"ok","timestamp":1762434779577,"user_tz":-180,"elapsed":48,"user":{"displayName":"Arman Vasilovich","userId":"14713620520292576430"}},"outputId":"02a0a8bb-2631-4022-84b1-7534a80cf895"},"execution_count":219,"outputs":[{"output_type":"execute_result","data":{"text/plain":["(60000, 784)"]},"metadata":{},"execution_count":219}]},{"cell_type":"code","source":["modell = tf.keras.Sequential([\n","    Dense(128, activation='relu', input_shape=(x_train.shape[1],)),\n","    Dense(256, activation='relu'),\n","    Dense(512, activation='relu'),\n","    Dense(10, 